                </svg>
                <span class="text-green-800 text-sm font-medium">Conversion successful!</span>
            </div>
            <button id="downloadBtn" class="w-full bg-blue-600 text-white font-bold py-4 rounded-2xl touch-active shadow-lg shadow-blue-200 transition-all">
