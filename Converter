    <a id="hiddenDownload" style="display:none"></a>

    <script>
        const fileInput = document.getElementById('fileInput');
        const statusArea = document.getElementById('statusArea');
        const resultArea = document.getElementById('resultArea');
        const progressBar = document.getElementById('progressBar');
        const statusLabel = document.getElementById('statusLabel');
        const statusPercent = document.getElementById('statusPercent');
        const downloadBtn = document.getElementById('downloadBtn');
        const dropZone = document.getElementById('dropZone');

        let convertedText = "";
        let originalFileName = "";

        fileInput.addEventListener('change', async (e) => {
            const file = e.target.files[0];
            if (!file) return;
            
            if (!file.name.toLowerCase().endsWith('.epub')) {
                showMessage("Please select a valid .epub file.");
                return;
            }

            originalFileName = file.name.replace(/\.[^/.]+$/, "");
            startConversion(file);
        });

        async function startConversion(file) {
            dropZone.classList.add('hidden');
            statusArea.classList.remove('hidden');
            
            try {
                updateProgress(10, "Reading file...");
                const zip = new JSZip();
                const contents = await zip.loadAsync(file);
                
                updateProgress(30, "Analyzing structure...");
                // Find all HTML/XHTML files in the EPUB
                const textFiles = Object.keys(contents.files).filter(path => 
                    path.endsWith('.xhtml') || path.endsWith('.html') || path.endsWith('.htm')
                ).sort();

                if (textFiles.length === 0) {
                    throw new Error("No text content found in EPUB.");
                }

                let fullText = "";
                const totalFiles = textFiles.length;

                for (let i = 0; i < totalFiles; i++) {
                    const fileName = textFiles[i];
                    const progress = 30 + Math.floor((i / totalFiles) * 60);
                    updateProgress(progress, `Extracting chapter ${i+1}...`);
                    
                    const htmlContent = await contents.files[fileName].async("text");
                    fullText += parseEpubHtml(htmlContent) + "\n\n";
                }

                convertedText = fullText.trim();
                
                updateProgress(100, "Done!");
                setTimeout(() => {
                    statusArea.classList.add('hidden');
                    resultArea.classList.remove('hidden');
                }, 500);

            } catch (err) {
                console.error(err);
                showMessage("Error: " + err.message);
                statusArea.classList.add('hidden');
                dropZone.classList.remove('hidden');
            }
        }

        function parseEpubHtml(html) {
            // Create a temporary DOM element to parse HTML
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            
            // Remove style and script tags
            const toRemove = doc.querySelectorAll('style, script, head, title');
            toRemove.forEach(el => el.remove());

            // Get text and handle whitespace
            let text = doc.body.innerText || doc.body.textContent || "";
            
            // Basic cleanup: remove excessive blank lines
            return text.replace(/\n\s*\n/g, '\n\n').trim();
        }

        function updateProgress(percent, text) {
            progressBar.style.width = percent + "%";
            statusPercent.innerText = percent + "%";
            statusLabel.innerText = text;
        }

        function showMessage(msg) {
            const msgBox = document.createElement('div');
            msgBox.className = "fixed top-4 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-6 py-3 rounded-full text-sm shadow-xl z-50 animate-bounce";
            msgBox.innerText = msg;
            document.body.appendChild(msgBox);
            setTimeout(() => msgBox.remove(), 3000);
        }

        downloadBtn.addEventListener('click', () => {
            if (!convertedText) return;
            
            const blob = new Blob([convertedText], { type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.getElementById('hiddenDownload');
            
            a.href = url;
            a.download = originalFileName + ".txt";
            a.click();
            
            setTimeout(() => URL.revokeObjectURL(url), 100);
        });

        // Touch interactions for the drop zone
        dropZone.addEventListener('touchstart', () => dropZone.classList.add('bg-slate-100'));
        dropZone.addEventListener('touchend', () => dropZone.classList.remove('bg-slate-100'));
    </script>
</body>
</html>

